{
  "name": "abdullah-sana-invitation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/origin.mjs && node tests/integration.mjs",
    "test:ui": "node tests/browser.mjs && node tests/countdown.mjs",
    "cf:build": "node scripts/cloudflare-build.mjs",
    "cf:preview": "npm run cf:build && wrangler d1 migrations apply DB --local && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler d1 migrations apply DB --remote && opennextjs-cloudflare deploy",
    "cf:setup": "node scripts/cloudflare-setup.mjs",
    "cf:test": "node scripts/cloudflare-test.mjs",
    "cf:test:ui": "node scripts/cloudflare-test.mjs browser"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.2.0",
    "@fontsource/aref-ruqaa": "^5.2.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
