{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abdullah-sana-invitation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "abdullah-sana-invitation"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abdullah-sana-invitation",
      "database_id": "db83d4f5-e675-48eb-bd39-41a56749342d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "abdullah-sana-media"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin"
  },
  "observability": {
    "enabled": true
  }
}
